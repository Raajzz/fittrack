# The backend base URL — the ONLY link between this app and the backend.
# Point it at any service that implements the FitTrack REST contract.
#
# Local dev (web / iOS simulator): http://localhost:8080
# Android emulator reaches host via 10.0.2.2: http://10.0.2.2:8080
# Physical device: use your machine's LAN IP, e.g. http://192.168.1.20:8080
# Production: https://api.yourdomain.com
EXPO_PUBLIC_API_URL=http://localhost:8080
