{
  "expo": {
    "name": "FitTrack",
    "slug": "fittrack",
    "scheme": "fittrack",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.fittrack.app"
    },
    "android": {
      "package": "co.fittrack.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "FitTrack uses your photos to log meals from pictures."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
